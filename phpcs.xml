<?xml version="1.0"?>
<ruleset name="Sparxstar Hybrid Standards">
    <description>WordPress VIP-style security with Modern PHP/PSR structure.</description>

    <!-- 1. CONFIGURATION -->
    <!-- Scan current directory -->
    <file>.</file>
    
    <!-- Exclude 3rd party code -->
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>
    <!-- Exclude built assets if any -->
    <exclude-pattern>/build/</exclude-pattern>

    <!-- CLI Output Settings -->
    <arg name="colors"/>
    <arg value="sp"/> <!-- Show progress & sniff codes -->
    <arg name="extensions" value="php"/>
    
    <!-- Memory/Cache Settings -->
    <arg name="cache" value=".phpcs.cache"/>
    <config name="showProgress" value="true"/>

    <!-- 2. BASE RULES: WORDPRESS (The "Law") -->
    <!-- We use WordPress-Extra (includes Core + Security + Best Practices) -->
    <!-- This covers 90% of "VIP" requirements unless you install the specific VIP package -->
    <rule ref="WordPress-Extra">
        <!-- Allow short array syntax [] instead of array() (Modern PHP) -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <rule ref="WordPress-Docs"/>
    <!-- <rule ref="WordPress-VIP-Go"/> -->


    <!-- 3. PSR Rules (That don't break WordPress) -->
    
    <!-- ENFORCE: PSR-12 File & Class Structure -->
    <!-- Removed PSR12 to avoid conflicts with WordPress standards (Braces, Spacing, Indent) -->
    <!-- <rule ref="PSR12"/> -->
    
    <!-- Allow slash-namespaces in hooks e.g. 'my-plugin/hook' -->
    <rule ref="WordPress.NamingConventions.ValidHookName">
        <properties>
            <property name="additionalWordDelimiters" value="-/"/>
        </properties>
    </rule>
    <!--
    <rule ref="PSR12.Files.EndFileNewline"/>
    <rule ref="PSR12.Files.OpenTag"/>
    <rule ref="PSR12.Files.FileClosingTag"/>
    <rule ref="PSR12.Classes.ClassDeclaration"/>
    <rule ref="PSR12.Properties.ConstantVisibility"/>
    -->

    <!-- ENFORCE: Modern PHP Logic -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.PHP.DeprecatedFunctions"/>
    <rule ref="Generic.CodeAnalysis.UselessOverridingMethod"/>
    <rule ref="Generic.CodeAnalysis.EmptyStatement"/>
    <rule ref="Generic.CodeAnalysis.ForLoopShouldBeWhileLoop"/>
    <rule ref="Generic.CodeAnalysis.JumbledIncrementer"/>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
    <!-- <rule ref="Generic.CodeAnalysis.UnusedVariable"/> -->

    <!-- 4. CONFLICT RESOLUTION (The "Hybrid" Part) -->
    
    <!-- ALLOW camelCase for methods (PSR style), but keep snake_case for global WP hooks -->
    <!-- Reverted to standard WordPress behavior to allow snake_case -->
    <!--
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <severity>0</severity>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName"/>
    -->

    <!-- LINE LENGTH: WordPress is stricter, but we allow 120 chars -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>

    <!-- 5. RULES TO EXCLUDE (Because they break WordPress) -->
    <!-- WordPress requires spaces inside parens: if ( $a ). PSR forbids it. -->
    <!-- We must EXCLUDE these PSR rules to avoid thousands of errors. -->
    <!--
    <rule ref="PSR12.ControlStructures.ControlStructureSpacing"/>
    <rule ref="PSR12.WhiteSpace.ScopeIndent"/> 
    -->

</ruleset>