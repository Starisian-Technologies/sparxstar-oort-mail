{
  "name": "starisian/sparxstar-sendgrid-runtime",
  "description": "SPARXSTAR SendGrid API-based transactional mailer for WordPress Multisite (MU-plugin) using SendGrid API SDK.",
  "type": "wordpress-muplugin",
  "authors": [
    {
      "name": "István Sárközi",
      "email": "istvan@sparxstar.com"
    }
  ],
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "composer/ca-bundle": "^1.5",
    "paragonie/sodium_compat": "^1.19",
    "paragonie/sodium_compat_ext_sodium": "^1.0",
    "sendgrid/sendgrid": "^8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7",
    "swissspidy/phpstan-no-private": "^0.2.1",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan-strict-rules": "^1.2",
    "phpstan/phpstan-deprecation-rules": "^1.0",
    "phpstan/phpstan-phpunit": "^1.2"
  },
  "autoload": {
    "classmap": []
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "lint": "phpcs -d memory_limit=2g .",
    "fix": "phpcbf -d memory_limit=2g .",
    "analyze": "phpstan analyse --memory-limit=2G"
  }
}