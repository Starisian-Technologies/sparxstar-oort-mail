{
  "name": "Starisian/Sparxstar-Oort-Mail",
  "description": "SendGrid API-based transactional mailer for WordPress Multisite (MU-plugin).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "sendgrid/sendgrid": "^8.1"
  },
  "autoload": {
